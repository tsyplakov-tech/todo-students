# Скопируйте в .env и заполните. Реальные значения не публикуйте.
MOODLE_LOGIN=your_moodle_login
MOODLE_FULL_NAME=Ваше ФИО из Moodle
API_TOKEN=replace_with_random_token_at_least_32_characters
PORT=3000
HOST=127.0.0.1
# Готовая БД: укажите свой логин, пароль, хост, порт и имя базы.
# Спецсимволы в логине и пароле URL-кодируйте.
DATABASE_URL=postgresql://db_user:db_password@db.example.com:5432/todo_students
# Для облака добавьте ?sslmode=verify-full к DATABASE_URL и используйте доверенный CA.
# PGSSLROOTCERT=/absolute/path/provider-ca.pem
