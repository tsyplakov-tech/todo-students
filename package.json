{
  "name": "todo-students",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Учебный список дел: Express, Prisma ORM и PostgreSQL",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "check": "eslint .",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 test/integration/*.test.js",
    "test:e2e": "playwright test",
    "build": "npm run prisma:generate && node scripts/build.js",
    "prisma:generate": "node --env-file-if-exists=.env scripts/prisma-cli.js generate && tsc -p tsconfig.prisma.json",
    "prisma:validate": "node --env-file-if-exists=.env scripts/prisma-cli.js validate",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma-cli.js migrate deploy",
    "db:status": "node --env-file-if-exists=.env scripts/prisma-cli.js migrate status",
    "db:baseline": "node --env-file-if-exists=.env scripts/prisma-cli.js migrate resolve --applied 20261123000000_init",
    "db:check": "node --env-file-if-exists=.env scripts/prisma-cli.js migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "supertest": "^7.1.4",
    "@playwright/test": "^1.56.1",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
